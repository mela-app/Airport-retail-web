{
  "name": "airport-retail-media-web",
  "version": "0.1.0",
  "private": true,
  "description": "Airport retail media platform, frontend: the five role views, the simulation bar, split-screen demo mode and the mobile claim page (React + Vite).",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "scan": "bash scripts/scan.sh"
  },
  "dependencies": {
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
