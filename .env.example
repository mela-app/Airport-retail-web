# Copy to .env for the Vite dev server (`pnpm dev`). Production settings live in deploy/compose.yaml.

# Where the backend listens; the dev server proxies /api (REST and the SSE stream) to it.
API_PROXY_TARGET=http://127.0.0.1:3000
# Port of the dev server (also opened on the LAN, so a phone can follow a screen's QR code).
WEB_PORT=5173

# Docker Compose only (in this .env as well):
#   WEB_HOST_PORT=8080      host port of the web app container
#   BIND_ADDRESS=0.0.0.0    also reachable from the LAN
#   ALLOWED_HOSTS=arm.example.com   domain names the app is opened under
